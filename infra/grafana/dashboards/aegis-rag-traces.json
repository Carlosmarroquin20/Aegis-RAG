          },
          "expr": "sum by (span_name)(rate(traces_span_metrics_duration_milliseconds_sum{span_name=~\"security.evaluate|rag.retrieve|llm.generate|output.sanitize\"}[5m])) / sum by (span_name)(rate(traces_span_metrics_duration_milliseconds_count{span_name=~\"security.evaluate|rag.retrieve|llm.generate|output.sanitize\"}[5m]))",
          "legendFormat": "{{span_name}}",
          "refId": "A",
