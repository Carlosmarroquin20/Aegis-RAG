# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
.venv/
venv/
env/

# uv
# Note: uv.lock IS committed intentionally for reproducible builds.

# Testing
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.mypy_cache/
.ruff_cache/

# Environment files — NEVER commit secrets
.env
.env.local
.env.*.local

# IDE
.vscode/settings.json
.idea/
*.swp
*.swo

# Docker
*.tar

# OS
.DS_Store
Thumbs.db

# Model cache (can be large)
.cache/huggingface/
sentence_transformers/

# Terraform state
infra/terraform/.terraform/
infra/terraform/*.tfstate
infra/terraform/*.tfstate.backup
# Real variable values may hold secrets — commit only the example.
infra/terraform/*.tfvars
!infra/terraform/*.tfvars.example
infra/terraform/crash.log
infra/terraform/crash.*.log
# Note: .terraform.lock.hcl IS committed (provider version pinning).

# ── Secrets & credentials — NEVER commit ─────────────────────────────────────
*.pem
*.key
*.crt
*.p12
*.pfx
*.jks
credentials.json
service-account*.json
secrets.yaml
secrets.yml
*.secrets
.htpasswd

# ── Uploaded / ingested documents (may contain sensitive data) ────────────────
uploads/
data/
*.pdf
*.docx

# ── Logs ──────────────────────────────────────────────────────────────────────
logs/
*.log

# ── Database / persistence files ──────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
chroma_data/

# ── Jupyter / notebook checkpoints ────────────────────────────────────────────
.ipynb_checkpoints/

# ── Local AI-assistant scaffolding (not part of the published project) ────────
CLAUDE.md
.claude/

# Archify render artifacts — the JSON specs are the source of truth; HTML is a build output
docs/diagrams/*.html
