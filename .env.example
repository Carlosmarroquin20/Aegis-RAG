# ── Application ───────────────────────────────────────────────────────────────
APP_NAME="Aegis-RAG"
# The version is not configured here: it is read from the installed package,
# i.e. from pyproject.toml.
DEBUG=false

# ── docker compose only ──────────────────────────────────────────────────────
# Host address the API (8000) and Grafana (3000) are published on. Loopback by
# default; every other service is always loopback-only. Set to 0.0.0.0 on a
# server where a firewall or security group controls access.
# AEGIS_PUBLIC_BIND=127.0.0.1
# Host port for the Ollama container. Change it if a native Ollama install is
# already using 11434 on this machine.
# OLLAMA_HOST_PORT=11434

# ── Security ──────────────────────────────────────────────────────────────────
# Comma-separated list of valid API keys.
# In production, inject these from a secrets manager (Vault, AWS Secrets Manager).
VALID_API_KEYS="replace-me-in-production,another-key"
SECURITY_STRICT_MODE=true
API_KEY_HEADER="X-API-Key"
# Generate keys with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Keys shorter than 32 characters are reported at startup.

# Lock a client address out (429) after this many rejected keys in the window.
# 0 disables it.
AUTH_FAILURE_LIMIT=10
AUTH_FAILURE_WINDOW_SECONDS=60
# Reverse proxies in front of the API that are trusted to set X-Forwarded-For.
# 0 = reached directly (header ignored). Set to 1 behind a single nginx / ALB.
# Do NOT raise this unless such a proxy really is in the path: with no proxy,
# the header is attacker-controlled and the throttle could be bypassed.
TRUSTED_PROXY_HOPS=0

# ── CORS ─────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Ignored when DEBUG=true.
# CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_BURST=10
# Backend for the sliding window: "memory" (single worker) or "redis" (shared
# across workers/replicas). The redis backend needs the optional dependency:
#   pip install "aegis-rag[redis]"
RATE_LIMIT_BACKEND=memory
REDIS_URL=redis://localhost:6379/0
# If the rate-limit store is unreachable: true serves requests unthrottled (they
# are still authenticated), false answers 503. Both are logged and counted in
# aegis_rate_limit_backend_errors_total.
RATE_LIMIT_FAIL_OPEN=true

# ── Vector Store (ChromaDB) ───────────────────────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION=aegis_documents

# ── LLM Backend ───────────────────────────────────────────────────────────────
# "ollama" (default): local model, nothing leaves the host.
# "openai_compatible": a hosted provider. The query and the retrieved document
#   excerpts are sent to it — do not use it for data that must stay on-prem.
LLM_PROVIDER=ollama

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_SECONDS=120

# Required when LLM_PROVIDER=openai_compatible. Any provider that implements
# POST {LLM_BASE_URL}/chat/completions works, for example:
#   Groq        https://api.groq.com/openai/v1
#   OpenRouter  https://openrouter.ai/api/v1
#   Mistral     https://api.mistral.ai/v1
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b
# LLM_API_KEY=            # keep the real key in .env (git-ignored), never here
# LLM_TIMEOUT_SECONDS=60

# ── Embeddings ────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

# ── Observability ─────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json   # "json" for production, "console" for development

# ── Tracing (OpenTelemetry) ───────────────────────────────────────────────────
# Off by default. Enabling it needs the optional dependency:
#   pip install "aegis-rag[otel]"
# Exporter: "console" prints spans (no backend needed); "otlp" ships them over
# OTLP/HTTP to OTLP_ENDPOINT (e.g. a Jaeger or Tempo collector on :4318).
TRACING_ENABLED=false
OTEL_EXPORTER=console
OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=aegis-rag
