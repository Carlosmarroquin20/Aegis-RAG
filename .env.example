# ── Application ───────────────────────────────────────────────────────────────
APP_NAME="Aegis-RAG"
APP_VERSION="0.1.0"
DEBUG=false

# ── Security ──────────────────────────────────────────────────────────────────
# Comma-separated list of valid API keys.
# In production, inject these from a secrets manager (Vault, AWS Secrets Manager).
VALID_API_KEYS="replace-me-in-production,another-key"
SECURITY_STRICT_MODE=true
API_KEY_HEADER="X-API-Key"

# ── CORS ─────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Ignored when DEBUG=true.
# CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_BURST=10
# Backend for the sliding window: "memory" (single worker) or "redis" (shared
# across workers/replicas). The redis backend needs the optional dependency:
#   pip install "aegis-rag[redis]"
RATE_LIMIT_BACKEND=memory
REDIS_URL=redis://localhost:6379/0

# ── Vector Store (ChromaDB) ───────────────────────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION=aegis_documents

# ── LLM Backend (Ollama) ──────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_SECONDS=120

# ── Embeddings ────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

# ── Observability ─────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json   # "json" for production, "console" for development

# ── Tracing (OpenTelemetry) ───────────────────────────────────────────────────
# Off by default. Enabling it needs the optional dependency:
#   pip install "aegis-rag[otel]"
# Exporter: "console" prints spans (no backend needed); "otlp" ships them over
# OTLP/HTTP to OTLP_ENDPOINT (e.g. a Jaeger or Tempo collector on :4318).
TRACING_ENABLED=false
OTEL_EXPORTER=console
OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=aegis-rag
