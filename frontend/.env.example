# Base URL of the Aegis-RAG API the built app talks to.
# Leave empty for same-origin (the nginx image and the Vite dev proxy both
# forward /api to the backend). Set it to reach a remote API directly, e.g.
# VITE_API_BASE_URL=https://aegis.example.com
VITE_API_BASE_URL=

# Public-demo build: bakes this API key into the bundle, hides the key field and
# makes the Documents tab read-only (see src/demo.ts and deploy/huggingface/).
# The key is readable by anyone who loads the page; leave empty otherwise.
VITE_DEMO_API_KEY=
