    {
      "dot": "rose",
      "title": "Security is the architecture",
      "items": [
        "SecurityGateway scores every query before retrieval — prompt injection blocked at 400",
        "OutputSanitizer guards every LLM response (LLM02)",
        "API-key auth (constant-time) + per-key sliding-window rate limit"
      ]
    },
    {
      "dot": "emerald",
      "title": "Hexagonal core",
      "items": [
        "Ports & adapters — swap ChromaDB or Ollama in one wiring file",
        "Query path: security -> retrieve -> generate -> sanitize",
        "Embeddings baked into the image (all-MiniLM-L6-v2) — boots fully offline"
      ]
    },
    {
      "dot": "cyan",
      "title": "Observability",
      "items": [
        "OTLP spans -> collector -> Jaeger + spanmetrics",
        "Prometheus + Grafana; exemplars jump from a metric to its trace",
        "Grafana reads traces from Jaeger for one-click drill-down"
      ]
    }
