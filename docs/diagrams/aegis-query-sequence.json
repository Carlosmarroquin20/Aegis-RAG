    },
    {
      "id": "chunks",
      "from": "store",
      "to": "api",
      "y": 306,
      "label": "top-k chunks",
      "variant": "return"
    },
    {
      "id": "generate",
      "from": "api",
      "to": "llm",
      "y": 342,
      "label": "generate(context, query)",
      "variant": "emphasis"
    },
    {
      "id": "answer",
      "from": "llm",
      "to": "api",
      "y": 396,
      "label": "answer",
      "variant": "return"
    },
    {
      "id": "sanitize",
      "from": "api",
      "to": "sanitizer",
      "y": 432,
      "label": "sanitize(answer)",
