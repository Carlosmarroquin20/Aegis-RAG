{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "Aegis-RAG — Security-First Query Pipeline",
    "output": "aegis-query-sequence.html",
    "viewBox": [
      1000,
      600
    ],
    "column_fit": "spread",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "screen",
        "label": "Security screen",
        "focus": [
          "client",
          "api",
          "gateway"
        ],
        "note": "Every query is scored before any retrieval or generation."
      },
      {
        "id": "rag",
        "label": "Retrieve + generate",
        "focus": [
          "api",
          "store",
          "llm"
        ],
        "note": "The RAG pipeline runs only on a CLEAN verdict."
      },
      {
        "id": "guard",
        "label": "Output guard",
        "focus": [
          "api",
          "sanitizer",
          "client"
        ],
        "note": "Every response is sanitized before it leaves the API."
      }
    ]
  },
  "participants": [
    {
      "id": "client",
      "type": "external",
      "label": "Client",
      "sublabel": "web console / API"
    },
    {
      "id": "api",
      "type": "backend",
      "label": "Aegis-RAG API",
      "sublabel": "FastAPI middleware"
    },
    {
      "id": "gateway",
      "type": "security",
      "label": "SecurityGateway",
      "sublabel": "LLM01 · pre-retrieval"
    },
    {
      "id": "store",
      "type": "database",
      "label": "ChromaDB",
      "sublabel": "vector store"
    },
    {
      "id": "llm",
      "type": "backend",
      "label": "Ollama",
      "sublabel": "llama3.2"
    },
    {
      "id": "sanitizer",
      "type": "security",
      "label": "OutputSanitizer",
      "sublabel": "LLM02 guard"
    }
  ],
  "segments": [
    {
      "from": 165,
      "to": 250,
      "label": "Security screen (LLM01)"
    },
    {
      "from": 265,
      "to": 405,
      "label": "Retrieve + generate"
    },
    {
      "from": 420,
      "to": 505,
      "label": "Sanitize + respond (LLM02)"
    }
  ],
  "messages": [
    {
      "id": "req",
      "from": "client",
      "to": "api",
