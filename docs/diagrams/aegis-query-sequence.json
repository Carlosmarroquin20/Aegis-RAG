  "activations": [
    {
      "participant": "api",
      "from": 182,
      "to": 496,
      "type": "backend"
    },
    {
      "participant": "gateway",
      "from": 206,
      "to": 242,
      "type": "security"
    },
    {
      "participant": "store",
      "from": 274,
      "to": 310,
      "type": "database"
    },
    {
      "participant": "llm",
      "from": 338,
      "to": 400,
      "type": "backend"
    },
    {
      "participant": "sanitizer",
      "from": 428,
      "to": 464,
      "type": "security"
    }
  ],
  "cards": [
    {
      "dot": "rose",
      "title": "Security-first ingress",
      "items": [
        "API key (constant-time) + per-key rate limit run in middleware before the route",
        "SecurityGateway screens every query before retrieval (LLM01)",
        "A BLOCKED verdict short-circuits to HTTP 400 — no retrieval, no LLM call"
      ]
    },
    {
      "dot": "emerald",
      "title": "Grounded RAG",
      "items": [
        "Retrieval and generation run only on a CLEAN verdict",
        "Answer grounded in top-k chunks from ChromaDB",
        "System prompt treats retrieved docs as untrusted data (indirect-injection guard)"
      ]
    },
    {
      "dot": "orange",
      "title": "Output guard",
      "items": [
        "OutputSanitizer checks every response (LLM02)",
        "A reflection leak fails loud as HTTP 500 — never a silent leak",
        "Each stage is wrapped in an OpenTelemetry span"
      ]
    }
  ]
}
