      "label": "POST /api/v1/query",
      "variant": "emphasis"
    },
    {
      "id": "evaluate",
      "from": "api",
      "to": "gateway",
      "y": 210,
      "label": "evaluate(query)",
      "variant": "security"
    },
    {
